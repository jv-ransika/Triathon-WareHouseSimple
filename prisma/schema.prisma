generator client {
  provider = "prisma-client-js"
}

// Prisma talks to libSQL through the driver adapter (src/lib/db.ts).
// This URL is only used by `prisma migrate diff`; schema is applied via scripts/db-apply.ts.
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  apiKeys      ApiKey[]
  orders       Order[]
}

model ApiKey {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  keyHash    String       @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  requests   ApiRequest[]

  @@index([userId])
}

// One row per public API request (including rejected ones), for usage monitoring.
// userId is kept even if the key is deleted so the owner still sees its history.
model ApiRequest {
  id         Int      @id @default(autoincrement())
  apiKeyId   String?
  apiKey     ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  userId     String?
  method     String
  route      String // pattern, e.g. /api/v1/orders/:id
  path       String // actual path, e.g. /api/v1/orders/ORD0000001
  status     Int
  durationMs Int
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
}

model Warehouse {
  id        String   @id // KDY | PLG
  name      String
  createdAt DateTime @default(now())
  stocks    Stock[]
  orders    Order[]
}

model Product {
  id               String      @id // temperature-specific ID, e.g. C32_FRESH_019_CHL
  brand            String
  tempRequirement  String // ambient | chilled
  unitWeightKg     Float
  unitVolumeM3     Float
  baseProductId    String // ID in the original 280-product catalogue
  basis            String
  temperatureBasis String
  verifiedRealSku  Boolean     @default(false)
  updatedAt        DateTime    @default(now()) @updatedAt
  items            OrderItem[]
  stocks           Stock[]

  @@index([brand])
  @@index([tempRequirement])
}

// Per-warehouse stock. quantity = available to order; reserved = locked by
// unconfirmed ("reserved") orders and not available to anyone else.
model Stock {
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  updatedAt   DateTime  @default(now()) @updatedAt

  @@id([warehouseId, productId])
  @@index([productId])
}

model Order {
  id              Int         @id @default(autoincrement())
  code            String      @unique
  status          String      @default("pending") // reserved | pending | shipped | delivered | cancelled | expired
  source          String      @default("ui") // seed | ui | api
  warehouseId     String
  warehouse       Warehouse   @relation(fields: [warehouseId], references: [id])
  tempRequirement String      @default("ambient") // ambient | chilled | mixed, derived from its products
  expiresAt       DateTime? // set while status = reserved
  createdById     String?
  createdBy       User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  totalWeightKg   Float       @default(0)
  totalVolumeM3   Float       @default(0)
  createdAt       DateTime    @default(now())
  items           OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([warehouseId, status])
  @@index([warehouseId, createdAt])
  @@index([status, expiresAt])
  @@index([warehouseId, tempRequirement])
}

model OrderItem {
  id                Int     @id @default(autoincrement())
  orderId           Int
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product @relation(fields: [productId], references: [id])
  quantity          Int // locked (reserved orders) or fulfilled quantity
  requestedQuantity Int // what the customer asked for

  @@index([orderId])
  @@index([productId])
}
